import pandas as pd

df = pd.read_csv('data/raw/content_refresh_anonymized.csv')

# Filter for mature, active pages
eligible = df[(df['impressions_90d'] > 0) & (df['content_age_days'] >= 90)]
print(f"1. Eligible Pages: {len(eligible):,} / {len(df):,} ({len(eligible)/len(df):.1%})")
